<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFCF9">

    <!-- MAIN SCROLL CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/header_gradient"
                android:padding="20dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:text="🤖 Rider Assistant"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Hands-free calling while driving"
                    android:textSize="12sp"
                    android:textColor="#DDFFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- STATUS BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusBluetooth"
                    android:text="🔵 Bluetooth"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/statusMic"
                    android:text="🎤 Mic"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/statusCall"
                    android:text="📞 Idle"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- VOICE STATUS -->
            <TextView
                android:id="@+id/voiceStatus"
                android:text="Listening for commands…"
                android:textSize="14sp"
                android:textColor="#626C7C"
                android:gravity="center"
                android:padding="12dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ACTIVE CALL CARD -->
            <LinearLayout
                android:id="@+id/callCard"
                android:visibility="gone"
                android:layout_margin="16dp"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/callName"
                    android:text="Calling"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/callTimer"
                    android:text="00:00"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#2180A1"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ACTIVITY LOG -->
            <TextView
                android:text="📋 Activity Log"
                android:textStyle="bold"
                android:layout_margin="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/activityLog"
                android:text="• App started\n• Bluetooth connected"
                android:textSize="12sp"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_margin="16dp"
                android:maxLines="6"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

    <!-- 🎤 BOTTOM CENTER MIC BUTTON -->
    <Button
        android:id="@+id/btnMic"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="🎤"
        android:textSize="28sp"
        android:background="@drawable/mic_button_bg"
        android:textColor="@android:color/white" />

</FrameLayout>
